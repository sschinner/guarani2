INSERT INTO tmp_inscrip_enc11
   select sga_det_acta_promo.unidad_academica, sga_det_acta_promo.carrera, sga_det_acta_promo.legajo, sga_comisiones.comision, sga_comisiones.materia, sga_det_acta_promo.plan, sga_det_acta_promo.version, sga_alumnos.nro_inscripcion

    FROM  sga_det_acta_promo,
         sga_actas_promo,
        sga_comisiones,
	sga_alumnos 
   WHERE sga_actas_promo.unidad_academica = sga_det_acta_promo.unidad_academica
     AND sga_actas_promo.acta = sga_det_acta_promo.acta
     AND sga_actas_promo.estado = 'C'
     AND sga_actas_promo.tipo = 'P'
     AND sga_det_acta_promo.rectificado = 'N'
     AND sga_det_acta_promo.resultado = 'P'
     AND sga_det_acta_promo.estado = 'A'

	AND sga_det_acta_promo.unidad_academica = sga_alumnos.unidad_academica
	AND sga_det_acta_promo.carrera = sga_alumnos.carrera
	AND sga_det_acta_promo.legajo = sga_alumnos.legajo

     AND sga_comisiones.comision = sga_actas_promo.comision
     AND sga_comisiones.anio_academico=i_anio_academico
     AND (sga_comisiones.periodo_lectivo = vc_periodo_lect or vc_periodo_lect is null);

   INSERT INTO tmp_inscrip_enc11
   select det_2.unidad_academica, det_2.carrera, det_2.legajo, sga_comisiones.comision, sga_comisiones.materia, det_2.plan, det_2.version, sga_alumnos.nro_inscripcion

    FROM sga_det_acta_promo  det_2,	 -- Detalle del Acta Rectificada
	 sga_actas_promo,   		 -- Cabecera del Acta
	sga_alumnos,
	 OUTER sga_det_acta_promo  det_1,	 -- Detalle del Acta Original
	 sga_comisiones
   WHERE sga_actas_promo.unidad_academica = det_2.unidad_academica 
     AND sga_actas_promo.acta             = det_2.acta  
     AND sga_actas_promo.tipo             = 'R' 
     AND sga_actas_promo.estado           = 'C' 
     AND det_2.rectificado   = 'N' 
     AND det_2.resultado     = 'P' 
     AND det_2.estado        = 'A'
     AND det_1.unidad_academica = det_2.unidad_academica
     AND det_1.carrera          = det_2.carrera
     AND det_1.legajo           = det_2.legajo
     AND det_1.acta             = sga_actas_promo.acta_referencia
     AND det_1.estado           = 'A'

	AND det_2.unidad_academica = sga_alumnos.unidad_academica
	AND det_2.carrera = sga_alumnos.carrera
	AND det_2.legajo = sga_alumnos.legajo


     AND sga_comisiones.comision = sga_actas_promo.comision
     AND sga_comisiones.anio_academico=i_anio_academico
     AND (sga_comisiones.periodo_lectivo = vc_periodo_lect or vc_periodo_lect is null)
     AND NOT EXISTS (SELECT ''  FROM sga_det_acta_promo  det_acta_orig
		WHERE det_acta_orig.unidad_academica = sga_actas_promo.unidad_academica
		   AND det_acta_orig.carrera = det_2.carrera
		   AND det_acta_orig.legajo   = det_2.legajo
		   AND det_acta_orig.acta     =  sga_actas_promo.acta_referencia
		   AND det_acta_orig.estado  <> 'A');  -- Que no este invalidado el registro original, si existe
-- Acta de Regulares
   INSERT INTO tmp_inscrip_enc11
   select dac.unidad_academica, dac.carrera, dac.legajo, sga_comisiones.comision, sga_comisiones.materia, dac.plan, dac.version, sga_alumnos.nro_inscripcion

    FROM sga_det_acta_curs   dac,
	sga_actas_cursado   ac,   
	sga_comisiones,
	sga_alumnos
   WHERE dac.unidad_academica = ac.unidad_academica
     AND dac.acta = ac.acta
     AND ac.estado = 'C'
     AND dac.cond_regularidad <> 2
     AND dac.estado = 'A'

	AND dac.unidad_academica = sga_alumnos.unidad_academica
	AND dac.carrera = sga_alumnos.carrera
	AND dac.legajo = sga_alumnos.legajo

     AND sga_comisiones.comision = ac.comision 
     AND sga_comisiones.anio_academico=i_anio_academico
     AND (sga_comisiones.periodo_lectivo = vc_periodo_lect or vc_periodo_lect is null);


-- ********************************************************************************************************************************************************************************
-- U820
-- ********************************************************************************************************************************************************************************


INSERT INTO tmp_carreras_enc11
SELECT DISTINCT sa.unidad_academica, sa.carrera, sa.legajo, sa.nro_inscripcion
FROM sga_alumnos sa, tmp_inscrip_enc11 ti
WHERE ti.unidad_academica = sa.unidad_academica
	AND ti.nro_inscripcion = sa.nro_inscripcion;


INSERT INTO tmp_comision_enc11 (unidad_academica, carrera, legajo, comision, materia, carrera_alu, plan_alu, version_alu)  
       SELECT unidad_academica, carrera, legajo, comision, materia, carrera, plan_alu, version_alu
         FROM tmp_inscrip_enc11;

IF c_mat_regul = 'S' THEN       

	DELETE FROM tmp_comision_enc11 
		WHERE NOT EXISTS 
			( SELECT '' 
				FROM tmp_cursadas_enc11
				WHERE unidad_academica = tmp_comision_enc11.unidad_academica
					AND carrera = tmp_comision_enc11.carrera
					AND legajo = tmp_comision_enc11.legajo
					AND comision = tmp_comision_enc11.comision);
END IF

IF c_una_x_doc = 'S' THEN
	INSERT INTO tmp_legajos_enc11
	SELECT tc.comision, sdc.legajo
		FROM tmp_comision_enc11 tc,
--			outer(sga_docentes_com sdc)
			sga_docentes_com sdc
		WHERE tc.comision = sdc.comision;
END IF;


insert into tmp_total_personas (unidad_academica, nro_inscripcion)
select distinct unidad_academica, nro_inscripcion
	from tmp_inscrip_enc11;

LET vi_cant_personas = DBINFO("SQLCA.sqlerrd2") ;

select min(id)
	into vi_min_id
	from tmp_total_personas;

select max(id)
	into vi_max_id
	from tmp_total_personas;

RETURN vi_cant_personas, vi_min_id, vi_max_id;

-- trace off;
END;

END PROCEDURE;
