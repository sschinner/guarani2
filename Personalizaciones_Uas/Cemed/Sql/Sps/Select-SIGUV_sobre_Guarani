5 BuscarCantidadInscriptos

    "SELECT ie.materia, amp.nombre_materia, ie.llamado, p.fecha, count(*) as cantidad" +
    " FROM " + guaraniBD + ":sga_insc_examen ie " +
    " JOIN " + guaraniBD + ":sga_atrib_mat_plan amp on (ie.carrera = amp.carrera " +
    " and ie.plan = amp.plan and ie.version = amp.version and ie.materia = amp.materia ) " +
    " JOIN " + guaraniBD + ":sga_carreras c on ie.carrera = c.carrera " +
    " JOIN " + guaraniBD + ":sga_llamados_mesa llm on (ie.anio_academico = llm.anio_academico " +
    " and ie.turno_examen = llm.turno_examen and ie.materia = llm.materia and ie.llamado = llm.llamado " +
    " and ie.mesa_examen = lm.mesa_examen ) " +
    " JOIN " + guaraniBD + ":sga_prestamos p on llm.prestamo = p.prestamo " +
    " WHERE ie.turno_examen = ? and ie.anio_academico = ? and ie.carrera = ? " +
    " GROUP BY 1,2,3,4 " +
    " ORDER BY 4,2";

6 completarNominaInscriptos

    "SELECT p.apellido, p.nombres, p.nro_documento" +
    " FROM " + guaraniBD + ":sga_insc_examen ie " +
    " JOIN " + guaraniBD + ":sga_alumnos a on ie.legajo = a.legajo and ie.carrera = a.carrera" +
    " JOIN " + guaraniBD + ":sga_personas p on a.nro_inscripcion = p.nro_inscripcion" +
    " WHERE ie.turno_examen = ? and ie.anio_academico = ? and ie.carrera = ? and ie.materia = ? and ie.llamado = ? " +
    " ORDER BY 1,2";

