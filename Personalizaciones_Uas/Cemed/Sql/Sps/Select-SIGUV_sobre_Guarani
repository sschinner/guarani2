1 BuscarClaveUsuario

    "SELECT clave "
    "FROM " + guaraniBD + ":aca_usuarios_ag " +
    "WHERE identificacion = '" + usuarioGuarani + "'
    "AND tipo_usuar_inicial = 'DOC'";

2 BuscarExamenesAlumnos

    "SELECT resultado, nota, fecha, forma_aprobacion" +
    "FROM " + guaraniBD + ":sga_personas AS p " +
    "JOIN " + guaraniBD + ":sga_alumnos AS a ON (p.nro_inscripcion = a.nro_inscripcion)" +
    "JOIN " + guaraniBD + ":vw_hist_academica AS h ON (a.legajo = h.legajo and a.carrera = h.carrera)" +
    "WHERE p.tipo_documento = ? AND p.nro_documento = ? AND a.carrera = ? AND h.materia = ?"

3 BuscarRegularidadAlumno

    "SELECT cond_regularidad,fecha_regularidad,fin_vigencia_regul " +
    "FROM " + guaraniBD + ":sga_personas p " +
    "JOIN " + guaraniBD + ":sga_alumnos AS a ON (p.nro_inscripcion = a.nro_inscripcion) " +
    "JOIN " + guaraniBD + ":sga_cursadas c ON (a.carrera = c.carrera and a.legajo = c.legajo) " +
    "JOIN " + guaraniBD + ":sga_comisiones co ON (c.comision = co.comision)" +
    "WHERE p.tipo_documento = '" + id_documento_tipo + "' and p.nro_documento = '" +
    "documento_numero + "' and c.plan = '" + id_propuesta_plan + "' and c.materia = '" + materia +
    "' and co.periodo_lectivo = '" + periodo_lectivo + "' and co.anio_academico ='" + periodo_lectivo_año + "'";

