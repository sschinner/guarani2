Execute procedure dba.sp_cambiaparametro( 'cur00115', 1 , 4, "dr820_certif_mat_aprob_esc_fcjs" );
Execute procedure dba.sp_cambiaparametro( 'cur00115', 1 , 5, "dl820_certif_mat_aprob_esc_fcjs" );
Execute procedure dba.sp_cambiaparametro( 'cur00115', 1 , 2, "dp820_alumno_carrera_obs_int" );


-- Actualizacion de certificados a imprimir Automaticamente.

begin;
update sga_certif_param set masc_captura_param = 'dp820_alumno_carrera_obs_int', mascara_pantalla = 'dr820_certif_mat_aprob', masc_impresion = 'dl820_certif_mat_aprob' where certificado = 5 and interfaz = 1;
delete from sga_certif_argum where certificado = 5 and orden = 6;
insert into sga_certif_argum values (5, 6, 'interior', 'char(', '', 'S', 'interior');
commit;
