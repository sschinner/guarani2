INSERT INTO dba.acc_acciones_oper ( operacion, accion ) VALUES ( '820egr50', 'M' );

begin;

set constraints all deferred;

-- Actividad: 8205 - Renovar Diploma
delete from mce_actividades where entidad = 1 and actividad = 8205;
