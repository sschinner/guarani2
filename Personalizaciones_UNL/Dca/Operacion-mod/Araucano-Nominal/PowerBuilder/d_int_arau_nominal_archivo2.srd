 retrieve="  SELECT int_araunom_rend.id_rendimiento,   
         int_araunom_rend.anio_academico,   
         int_araunom_rend.tipo_documento,   
         int_araunom_rend.nro_documento,   
         int_araunom_rend.cuil_cuit,   
