 retrieve="  SELECT int_araunom_alu.id_alumno,   
         int_araunom_alu.anio_academico,   
         int_araunom_alu.tipo_documento,   
         int_araunom_alu.nro_documento,   
         int_araunom_alu.cuil_cuit,   
         int_araunom_alu.genero,   
         int_araunom_alu.fecha_nacimiento,   
         int_araunom_alu.horas_trabajo,   
         int_araunom_alu.nivel_inst_padre,    
         int_araunom_alu.nivel_inst_madre,   
         int_araunom_alu.nacimiento_pais,   
         int_araunom_alu.nacimiento_loc  
    FROM int_araunom_alu   
   WHERE int_araunom_alu.anio_academico = :anio_academico   
" update="int_araunom_alu" updatewhere=1 updatekeyinplace=no arguments=(("anio_academico", string)) )
