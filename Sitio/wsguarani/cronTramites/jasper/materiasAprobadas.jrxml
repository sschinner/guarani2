				<textElement>
					<font isPdfEmbedded="true"/>
				</textElement>
				<text><![CDATA[CERTIFICADO DE ASIGNATURAS APROBADAS]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement style="reporte_subtitulo" positionType="Float" x="0" y="20" width="455" height="15" uuid="6c41a360-8ec1-4ab0-bb37-51ddb5abb4a5"/>
				<textElement>
