		</band>
		<band height="75" splitType="Stretch">
			<textField>
				<reportElement style="reporte_texto" stretchType="RelativeToTallestObject" x="0" y="0" width="455" height="75" uuid="4ed7ad3f-b53a-4a74-a668-3bf40d28af5a"/>
				<textElement textAlignment="Justified">
					<font isPdfEmbedded="true"/>
				</textElement>
				<textFieldExpression><![CDATA[($F{ua} == "ISM" ?
"Las autoridades de la Facultad de Humanidades y Ciencias y del Instituto Superior de Música - dependiente de la FHUC - quienes suscriben, certifican que "
:
"La autoridad " + ($F{ua} == "CU-RA" || $F{ua} == "CU-G" ? "del " : "de la ") + $F{nombreFacultad} + " que suscribe, certifica que ") +
(
$F{tipoDeCarrera} == 'P' || $F{tipoDeCarrera} == 'W' ?
( $F{titSuperiorPrevio}.equals( null ) ? "" : "el/la " + $F{titSuperiorPrevio} + " " )
:
""
)
+ $F{apellido} + ", " + $F{nombres} + " " +
$F{tipoDocDescripcion} + ": " + $F{nroDocumento} + " y Nro. de Legajo "+ ($F{legajo}.equals(null) ? "(pendiente)" : $F{legajo}) + ", ha obtenido las siguientes equivalencias (con o sin nota) y calificaciones en los exámenes aprobados" +
(
$F{tipoDeCarrera} == 'I' || $F{tipoDeCarrera} == 'E' || $F{tipoDeCarrera} == 'B' || $F{tipoDeCarrera} == 'V' ?
    ".\n"
    :
    ", en la carrera de " + $F{nombreCarrera} + " (Plan: " + $F{planAlumno} + ").\n"
)]]></textFieldExpression>
			</textField>
		</band>
		<band height="50">
