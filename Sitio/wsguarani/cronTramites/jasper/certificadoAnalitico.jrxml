		<band height="75" splitType="Stretch">
			<textField>
				<reportElement style="reporte_texto" stretchType="RelativeToTallestObject" x="0" y="0" width="455" height="75" uuid="4ed7ad3f-b53a-4a74-a668-3bf40d28af5a"/>
				<textElement textAlignment="Justified">
					<font isPdfEmbedded="true"/>
				</textElement>
				<textFieldExpression><![CDATA[($F{ua} == "ISM" ? "Las autoridades de la Facultad de Humanidades y Ciencias y del Instituto Superior de Música - dependiente de la FHUC - quienes suscriben, certifican que "
:
"La autoridad " + ($F{ua} == "CU-RA" || $F{ua} == "CU-G" ? "del " : "de la ") + $F{nombreFacultad} + " que suscribe, certifica que ")
+ ( $F{titSuperiorPrevio}.equals( null ) ? "" : ($F{sexo} == "M" ? "el " : "la ") + $F{titSuperiorPrevio} + " " ) + $F{apellido} + ", " + $F{nombres} + " " + $F{tipoDocDescripcion} + ": " + $F{nroDocumento} + ", posee la siguiente historia académica, en la carrera de " + $F{nombreCarrera} + " (Plan: " + $F{plan} + ") con el título de " + $F{nombreTitulo} + ".\n" +

(
$F{nroResolucionPlan} == "SR" ?
     "Resolución Ministerial en trámite"
     : (
         $F{nroResolucionPlan}.substring( 0, 3 ) == "CS-" ?
            "Reconocimiento oficial otorgado por Resolución de Consejo Superior Nº: " + $F{nroResolucionPlan}
            : "Validez nacional y reconocimiento oficial otorgados por Resolución Ministerial Nº: " + $F{nroResolucionPlan}
        )
)

+ "."]]></textFieldExpression>
			</textField>
