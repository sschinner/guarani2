	<style name="Row" mode="Transparent" fontName="Arial" fontSize="8" isBold="false" isItalic="false" isUnderline="false" isStrikeThrough="false"/>
	<queryString language="xPath">
		<![CDATA[/HistoriaAcademica/datos/item]]>
	</queryString>
