		<fieldDescription><![CDATA[ra_email]]></fieldDescription>
	</field>
	<variable name="fecha_narrada" class="java.lang.String">
		<variableExpression><![CDATA[new java.text.SimpleDateFormat("dd 'días del mes de' MMMM 'de' yyyy", new java.util.Locale("es")).format(new java.util.Date())]]></variableExpression>
	</variable>
	<pageHeader>
		<band height="145" splitType="Stretch">
			<image hAlign="Center">
				<reportElement x="252" y="12" width="80" height="65" uuid="844e6f71-707f-488b-96c9-20dc2298462d"/>
				<imageExpression><![CDATA["../img/efebo.png"]]></imageExpression>
			</image>
			<staticText>
				<reportElement style="Title" x="117" y="115" width="328" height="23" uuid="8ece72e2-a9b4-4011-b303-675bb37c22f0"/>
				<textElement textAlignment="Center">
					<font fontName="Arial" size="11" pdfFontName="Times-Bold"/>
				</textElement>
				<text><![CDATA[CERTIFICADO DE TÍTULO EN TRÁMITE]]></text>
			</staticText>
		</band>
	</pageHeader>
	<detail>
		<band height="88">
			<textField>
				<reportElement style="Comun" x="54" y="0" width="447" height="82" uuid="44dda35e-329e-4b0c-acf8-29e59acc9736"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial" size="9" isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA["La autoridad "
+ ($F{ra_nombre}.equals("Centro Universitario - Reconquista Avellaneda") || $F{ra_nombre}.equals("Centro Universitario Gálvez") ?
    "del " + $F{ra_nombre}
    :
    ($F{ra_nombre}.equals("Instituto Superior de Música") ?
        "de la Facultad de Humanidades y Ciencias"
        :
        "de la " + $F{ra_nombre}
    )
   )

+ " de la Universidad Nacional del Litoral que suscribe, certifica que " + $F{apellido_y_nombre} + ", " + $F{documento_principal}
+ ($F{ra_nombre}.equals( "Instituto Superior de Música" ) ? ", graduado/a del Instituto Superior de Música, dependiente de la FHUC" : "")
+ ", tiene en trámite su título de " + $F{certificado_nombre} + ", habiendo aprobado su última materia en fecha " + $F{fecha_egreso_alumno} + ".\n \n "
+ "A pedido del/la interesado/a y para ser presentado ante quién corresponda, se extiende el presente en la ciudad " + $F{localidad_nombre} + ", Pcia. de " + $F{provincia_nombre} +", Argentina, A " + $V{fecha_narrada} + "."]]></textFieldExpression>
			</textField>
		</band>
	</detail>
