      <div>
            <legend class="clearfix">
                <span class="pull-left"><h3 class="resaltar">{{datos.nombreTitulo|trans}}</h3></span>

            </legend>
            <form name="inicio" id="inicio" action="{{datos.urlRedir}}" method="POST">
                 <input type="text" name="fUsuario" id="fUsuario" size="25" maxlength="50" value="{{datos.usuario}}" style="display: none;"><br><br>
                 <input type="password" name="fClave" id="fClave" size="35" maxlength="100" value="{{datos.pass}}" style="display: none;">
                <br><br>
                
                
            </form>
        </div>

{% endblock contenido %}
