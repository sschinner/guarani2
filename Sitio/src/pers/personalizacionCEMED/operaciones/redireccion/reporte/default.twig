{% extends "kernel/pagelet.twig" %}
{% block contenido %}

    {% set datos=this.get_data_reporte() %}
  
    <script>
        $(document).ready(function () {
           
           document.forms['inicio'].submit();
           alert('RECUERDE CERRAR LA SESION DE GUARANI AL FINALIZAR.');
        });



    </script>
   <!DOCTYPE html>
<!--
