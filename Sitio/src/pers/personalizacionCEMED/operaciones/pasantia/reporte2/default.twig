{% extends "kernel/pagelet.twig" %}
{% block contenido %}
<script>
function darDeBaja(id,nombre){
       if (confirm("Desea darse de baja en la pasantia '"+nombre+"' ?")){
            $("#id_pasantia_baja").val(id);
            document.baja_pasantia.submit();
        }
       
   }
</script>
{% set nombre='Pasantias en la que estoy inscripto'%}
{% set datos=this.get_data_reporte() %}
{%if (datos.cantRegistros!=0)%}
<div id="propio" style="width:480px;">

<form method="POST" action="{{datos.url}}" name="baja_pasantia" id="baja_pasantia">
   

        <legend class="clearfix">
            <span class="pull-left"><h3 class="resaltar">{{datos.nombreTitulo|trans}}</h3></span>

        </legend>

    <br>
        <table class="table table-striped table-condensed">
            
            {% for fila in datos.datosIns %}
            <tr >  
                <td>
                    <a role="button" tabindex="0" class="btn btn-mini btn-warning pull-right" onclick="darDeBaja('{{fila.2}}','{{fila.4}}');" >{{ "dar de baja"|capitalize }}</a>
                </td>
                <td > 
                <div class="pull-left" >
                    <p style="font-size:10pt;"><b>{{fila.4}}</b></p>
                </div>
                    
                </td>
               
                
            </tr>
             {%endfor%}
        </table>
       
        <input type="hidden" id="id_pasantia_baja" name="id_pasantia_baja" value=""/>
        
    
    {% if this.data.mensajes2 %}
    <div class='alert alert-error' style="width:300px;">
           {% import "kernel/macro_notificaciones.twig" as notificaciones %}
	   {{ notificaciones.render_notif(this.data.mensajes2) }}
    </div>
    {% endif %}
</form>  

</div>
{%endif%}
{% endblock contenido %}