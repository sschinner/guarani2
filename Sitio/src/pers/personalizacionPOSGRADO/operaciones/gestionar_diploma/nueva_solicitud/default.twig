{% extends "kernel/pagelet.twig" %}
{% block contenido %}
    <style>
        input[type=checkbox] {
            transform: scale(1.5);
        }

        

    </style>
    <script >

        $(document).ready(function () {
            $("#labelAutoriza").hide();
            $("#inputAutorizaNombre").hide();
            $("#divAutorizaNombre").hide();
            $("#inputAutorizaApellido").hide();
            $("#divAutorizaApellido").hide();
            $("#inputAutorizaDNI").hide();
            $("#divAutorizaDNI").hide();
            $("#precioCon").hide();
            $("#precioSin").hide();

            $("#open").click(function () {
                url = $(this).attr("href");
                window.open(url, '_blank');
                return false;
            });
            $("#openExpediente").click(function () {
                url = $(this).attr("href");
                window.open(url, '_blank');
                return false;
            });


        });
        function habilita() {
            if ($('#checkAutoriza').is(':checked')) {
                $("#inputAutorizaNombre").show();
                $("#divAutorizaNombre").show();
                $("#inputAutorizaApellido").show();
                $("#divAutorizaApellido").show();
                $("#inputAutorizaDNI").show();
                $("#divAutorizaDNI").show();
                $("#autorizaApellido").attr('required', 'true');
                $("#autorizaNombre").attr('required', 'true');
                $("#autorizaDNI").attr('required', 'true');
            } else {
                $("#inputAutorizaNombre").hide();
                $("#divAutorizaNombre").hide();
                $("#inputAutorizaApellido").hide();
                $("#divAutorizaApellido").hide();
                $("#inputAutorizaDNI").hide();
                $("#divAutorizaDNI").hide();
                $("#autorizaApellido").removeAttr('required');
                $("#autorizaNombre").removeAttr('required');
                $("#autorizaDNI").removeAttr('required');
            }
        }

        function habilitaSolicitar() {
            if ($('#checkSolicita').is(':checked')) {
                $("#js-btn-confirmar").removeAttr('disabled');
            } else {
                $("#js-btn-confirmar").attr('disabled', 'true');
            }
        }

        $('select#diploma').on('change', function () {
            var valor = $(this).val();
            /* Se habilita el boton para solicitar */
            /*$("button[name='solicitar']").removeAttr('disabled');
             verifica();
             /*-----*/




            if (valor === "S") {
                $("#precioCon").show(1000);
                $("#precioSin").hide();
                $("#labelAutoriza").show();
                // $("#inputAutorizaNombre").hide();



            } else if (valor === "N") {
                $("#precioSin").show(1000);
                $("#precioCon").hide();

                $("#labelAutoriza").hide();
                $("#inputAutorizaNombre").hide();
                $("#divAutorizaNombre").hide();
                $("#inputAutorizaApellido").hide();
                $("#divAutorizaApellido").hide();
                $("#inputAutorizaDNI").hide();
                $("#divAutorizaDNI").hide();
                $('#checkAutoriza').removeAttr('checked');
                $("#autorizaApellido").removeAttr('required');
                $("#autorizaNombre").removeAttr('required');
                $("#autorizaDNI").removeAttr('required');
            }else{ 
                $("#precioCon").hide();
                $("#precioSin").hide();
                $("#labelAutoriza").hide();
                $("#inputAutorizaNombre").hide();
                $("#divAutorizaNombre").hide();
                $("#inputAutorizaApellido").hide();
                $("#divAutorizaApellido").hide();
                $("#inputAutorizaDNI").hide();
                $("#divAutorizaDNI").hide();
                $('#checkAutoriza').removeAttr('checked');
                $("#autorizaApellido").removeAttr('required');
                $("#autorizaNombre").removeAttr('required');
                $("#autorizaDNI").removeAttr('required');
            }

        });
    </script>

    <div class="titulo_operacion">



    </div>

