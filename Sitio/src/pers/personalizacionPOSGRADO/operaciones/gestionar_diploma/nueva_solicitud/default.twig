                                            </div>
                                        </td>
                                        <td >
                                            <div >
                                                <input type="text"  value="{{this.data.u820_diploma.AUTORIZADO_DOCUMENTO}}" readonly />
                                            </div>
                                        </td>  
                                    {%endif%}    

                                </tr>
                                <tr>
                                    <td colspan="4">
                                        <div class="col-xs-12 col-md-12">
                                            <hr>
                                        </div>
                                    </td>

                                </tr>
                                {%if (this.data.inicioSolicitud == false)%}
                                    <tr>
                                        <td colspan="4">

                                            <div class=" col-xs-12 col-md-12" style="display:flex;">
                                                <input type="checkbox" onchange="habilitaSolicitar();" id="checkSolicita" name="checkSolicita" style="margin-left:1%"/>{#<p style="margin-left:1%;padding-top:1%"> <b>Acepto la publicaci&oacute;n de mis datos en el Registro P&uacute;blico de Graduados Universitarios</b></p>#}
                                                <p style="margin-left:1%; padding-top:2%"> <b>Declaro estar en conocimiento de la normativa de expedici&oacute;n de diplomas y que los datos consignados son correctos. Acepto la publicaci&oacute;n de mis datos en el Registro P&uacute;blico de Graduados Universitarios</b></p>
                                            </div>                                   
                                            {#<div class=" col-xs-12 col-md-12" style="display:flex;">
                                                
                                            </div>              #}                     
                                        </td>

                                    </tr>
                                {%endif%}
                            </table>
                            <div class="collapse col-xs-12 col-md-12">

                            </div><br>
                            <div class="pull-right" >
                                {%if (this.data.titulos is not empty) %}
                                    <button id="js-btn-confirmar" class="btn btn-info" type="submit" disabled="true"><i class="icon-ok icon-white"></i> {{ "solicitar_certificacion.solicitar" | trans }}</button>
                                {%endif%}
                                <br><br>
                            </div>
                            {%if (this.data.inicioSolicitud == true) and (this.data.u820_certif.ESTADO_PAGO != 'P') %}    
                                <div class="row">
                                    <div id="mensaje" role="alert" class="alert alert-info" style="margin-left:3%;">
                                        <p style="font-size:11pt;"> El tr&aacute;mite se inicio correctamente, por favor contin&uacute;e con el sigiuente paso, <b> Abonar Tasa </b></p>
                                    </div>
                                </div>
                            {%endif%}
                            
                        </form>
                    </div>

                </div>
            </div>
            <div class="row" style="margin-left: 0px">
                <div class="col-xs-12 col-md-12">
                    <div class="col-xs-12 col-md-12" style="background-color:#d7d7d7;">
                        <button type="button" class="btn btn-link" style="font-size: 14pt;" data-toggle="collapse" data-target="#abonarDiploma" >Abonar Tasa </button>
                    </div>
                    <br>

                    <div id="abonarDiploma" class="collapse col-xs-12 col-md-12">
                        <div class="col-xs-12 col-md-12">
                            <p>Una vez que realice la solicitud podr&aacute; acceder a pagar la tasa del Diploma   </p>
                            {%if (this.data.u820_certif is not defined) or
                                             (this.data.u820_certif.ESTADO_PAGO == 'P')%}
                            <input type="button" class="btn btn-info" disabled value="PAGAR" style="cursor:pointer;"/>
                        {%else%}
                            <a  href="{{this.data.urlPagarDiploma}}" id="open" name="open" >
                                <input type="button" class="btn btn-info" value="Pagar" style="cursor:pointer;"/></a><i class="icon-ok icon-white"></i> 
                            {%endif%}
                        <br><br>
                    </div>
                </div>
            </div>
        </div>
        <div class="row" style="margin-left: 0px">
            <div class="col-xs-12 col-md-12">
                <div class="col-xs-12 col-md-12" style="background-color:#d7d7d7;">
                    <button type="button" class="btn btn-link" style="font-size: 14pt;" data-toggle="collapse" data-target="#digitalizar" >Digitalizar Requisitos </button>
                </div>
                <br>

                <div id="digitalizar" class="collapse col-xs-12 col-md-12">
                    <div class="col-xs-12 col-md-12">
                        <div id="mensaje" role="alert" class="alert alert-info">
                            <p>Finalizada la digitalizaci&oacute;n de la documentaci&oacute;n debe dirigirse al departamento alumnado para validar la misma f&iacute;sicamente. El tr&aacute;mite es personal.</p>
                        </div>
                        {%if (this.data.u820_diploma is defined)%}   
                            <table class="table table-responsive table-condensed " >
                                <th>Requisitos necesarios a digitalizar</th>
                                <th>Estado</th>
                                <tbody>
                                    {%for fila in this.data.requisitosCertif%}
                                        <tr {%if (fila.URL == '') %}class="warning"{%else%}class="success"{%endif%}>
                                            <td > 
                                                {{fila.NOMBRE_REQUISITO}} 
                                            </td>
                                            <td>
                                                {%if (this.data.u820_diploma is defined) 
                                                            and (this.data.u820_diploma.REQUISITOS_VALIDADOS == 'S')%}
                                                    <span style="color:blue"> <b>    VALIDADO</b></span>    
                                                {%else%}
                                                    {%if (fila.URL != '') %}
                                                            <span style="color:blue"> <b>    Cargado!</b></span>
                                                    {%else%}
                                                        <span>Falta Cargar</span>
                                                    {%endif%}
                                                {%endif%}
                                            </td>    
                                        </tr>
                                    {%endfor%}
                                </tbody>
                            </table>
                        {%else%}   
                            <p>Una vez que realice la solicitud podr&aacute; acceder a conocer y digitalizar los requisitos</p>
                            <p>El proceso de carga y digitalizaci&oacute;n de los requisitos puede realizarlo tantas veces como desee y sin restricci&oacute;n de tiempo</p>
                        {%endif%}
                        
                        <div class="col-xs-12 col-md-12">
                            <hr>
                        </div>
                        {%if (this.data.u820_diploma is not defined) or
                                             (this.data.u820_diploma.REQUISITOS_VALIDADOS == 'S')%}

                        {%else%}
                            {%for  fila in this.data.iframes %}
                                <div class="col-xs-12 col-md-12">
                                    <label>Requisito a digitalizar: <b>{{fila.nombreRequisito}}</b></label>


                                    <iframe id="frame+{{fila.identificador}}" name="frame+{{fila.identificador}}" src="{{fila.url}}" FRAMEBORDER="No"  style="width: 100%;height: 250px;">

                                    </iframe>
                                    <br><br>
                                </div>
                            {%endfor%}
                        {%endif%}
                            </div>
                        </div>
                    </div>
                </div> 
                <div class="row" style="margin-left: 0px">
                    <div class="col-xs-12 col-md-12">
                        <div class="col-xs-12 col-md-12" style="background-color:#d7d7d7;">
                            <button type="button" class="btn btn-link" style="font-size: 14pt;" data-toggle="collapse" data-target="#seguimientoTramite" >Seguimiento de la Solicitud </button>
                        </div>
                        <br>

                        <div id="seguimientoTramite" class="collapse col-xs-12 col-md-12">
                            <div class="col-xs-12 col-md-12">
                                <p>Una vez abonada la solicitud podr&aacute; acceder al sistema de Mesa de Entrada para seguir el tr&aacute;mite (puede demorar hasta 48 hs.)</p>
                                {%if (this.data.u820_certif is not defined) or
                                             (this.data.u820_certif.EXPEDIENTE == '')%}
                                <input type="button" class="btn btn-info" disabled value="Mesa de Entrada" style="cursor:pointer;"/>
                                {%else%}
                                    <a  href="{{this.data.urlMesaEntrada}}" id="openExpediente" name="openExpediente" >
                                        <input type="button" class="btn btn-info" value="Mesa de Entrada" style="cursor:pointer;"/>
                                    </a><i class="icon-ok icon-white"></i> 
                                {%endif%}
                                <br><br>
                            </div>
                        </div>
                    </div>
                </div>            
        {%endif%}

    </div>

{%endblock%}