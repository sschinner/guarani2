{% extends "kernel/pagelet.twig" %}
{% block contenido %}
<script>
    
function inscribirAlumno(nombre,comision){
       if (confirm("Desea inscrbirse a la materia '"+nombre+"' ?")){
           $("#comision").val(comision);
            document.inscribir.submit();
        }
       
   }
   
</script>
{% set nombre='Pasantias en la que estoy inscripto'%}
{% set datos=this.get_data_reporte() %}
{%if (datos.datosComision is defined)%}
<div id="propio" style="width:450px;">

<form method="POST" action="{{datos.url}}" name="inscribir" id="inscribir">
   

        <legend class="clearfix">
            <span class="pull-left"><h3 class="resaltar">{{datos.nombreTitulo|trans}}</h3></span>

        </legend>

    <br>
        <table class="table table-striped table-condensed">
            <tr>
                <td><b>Facultad destino</b></td>
                <td><b>Comisi&oacute;n</b></td>
                <td><b>Materia</b></td>
                <td></td>
            </tr>
            {% for fila in datos.datosComision %}
            <tr >  
                <td>
                    {{fila.unidad_academica_destino}}
                    
                </td>
                <td>
                   {{fila.nombre}} - {{fila.comision}} 
                </td>
                <td>
                   {{fila.nombre_materia_destino}}
                </td>
                <td > 
                    <a role="button" tabindex="0" class="guardar btn btn-mini btn-warning pull-right" onclick="inscribirAlumno('{{fila.nombre_materia_destino}}','{{fila.comision}}');" >{{ "Inscribir"|capitalize }}</a>
                </td>
               
                
            </tr>
             {%endfor%}
        </table>
       
        <input type="hidden" id="id_materia" name="id_materia" value="{{datos.materia}}"/>
        <input type="hidden" id="comision" name="comision" value=""/>
       
       
    
    {% if this.data.mensajes2 %}
    <div class='alert alert-error' style="width:300px;">
           {% import "kernel/macro_notificaciones.twig" as notificaciones %}
	   {{ notificaciones.render_notif(this.data.mensajes2) }}
    </div>
         {%elseif this.data.mensajes2%}
        <br>
        <br>
        <br>
        <div style="width:400px;">
               {% import "kernel/macro_notificaciones.twig" as notificaciones %}
               {{ notificaciones.render_notif(this.data.mensajes2) }}
        </div>
    {% endif %}
   
</form>  

</div>
{%endif%}
{% endblock contenido %}