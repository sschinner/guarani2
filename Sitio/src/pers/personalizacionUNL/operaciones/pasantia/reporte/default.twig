{% extends "kernel/pagelet.twig" %}
{% block contenido %}

{% set datos=this.get_data_reporte() %}
{% set nombre='Encuesta Graduados: actualización de datos'%}
<script>

    function incribir(id, nombre) {
        if (confirm("Desea incribirse en la pasantia '" + nombre + "' ?")) {
            $("#pas_id").val(id);

            document.guardaDatos.submit();
        }

    }

</script>

<div id="propio2" {%if (datos.cantRegistros!=0)%} style="margin-left: 270px;"{%endif%}>
    <form name="guardaDatos" id="guardaDatos" action="{{this.data.url.guardar}}" method="POST" >

        <legend class="clearfix">
            <span class="pull-left"><h3 class="resaltar">{{datos.nombreTitulo|trans}}</h3></span>

        </legend>
        {%if (datos.cantPasantias!=0)%}
        <br>
        <table class="table table-striped table-condensed">

            {% for fila in datos.datosAlu %}
            <tr style="padding-bottom: 2px;padding-top: 2px;padding-right: 4px;">   
                <td style="padding-bottom: 2px;padding-top: 2px;padding-right: 4px;" > 
                    <div class="pull-left" >
                        <p style="font-size:10pt;"><b>{{fila.4}}</b></p>
                    </div>

                </td>
                <td width="20px;">

                </td>
                <td>
                    <a role="button" tabindex="0" class="guardar btn btn-info btn-mini pull-right" onclick="incribir('{{fila.2}}', '{{fila.4}}')" >{{ "incribirme"|trans|capitalize }}</a>
                </td>
            </tr>
             {%endfor%}
        </table>

        <input type="text" id="pas_id" name="pas_id" value="" style="display:none;"/>
    </form>        

    {% if this.data.mensajes %}
    <div class='alert alert-error' style="width:400px;">
           {% import "kernel/macro_notificaciones.twig" as notificaciones %}
	   {{ notificaciones.render_notif(this.data.mensajes) }}
    </div>
    {% endif %}
    {%elseif (datos.cantRegistros==0)  %}
    <br>
    <br>
    <br>
    <span class="pull-left">  <p style="font-size:12pt;">No hay pasant&iacute;as vigentes</p>   </span>
    {%else%}
     {% if this.data.mensajes %}
    <br>
    <br>
    <br>
    <div class='alert alert-error' style="width:400px;">
           {% import "kernel/macro_notificaciones.twig" as notificaciones %}
	   {{ notificaciones.render_notif(this.data.mensajes) }}
    </div>
    {% endif %}
    {%endif%}
</div>

{% endblock contenido %}