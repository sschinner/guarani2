{% extends "kernel/pagelet.twig" %}
{% block contenido %}

    <!-- Controles -->
    <div class="titulo_operacion">
        <h2 class="clearfix"><span class="pull-left">{{"actas_de_promocion"|trans|capitalize}}</span>
            <div class="pull-right">
                <a class="btn no-ajax" target="_blank" href="{{this.data.url.generar_pdf}}"><span class="acchide">{{'descargar_pdf'|trans|capitalize}}</span><span class="g3w-icono-pdf"></span></a>
                <a class="btn no-ajax" target="_blank" href="{{this.data.url.generar_excel}}"><span class="acchide">{{'descargar_xls'|trans|capitalize}}</span><span class="g3w-icono-xls"></span></a>
            </div>
        </h2>
    </div>

	<div id="filtros" class="well">
	    <form action="{{this.data.url_form_filtro}}" method="get" id="filtro_form">
		{% set datos_filtros = this.get_datos_filtros() %}
		<table summary="filtros">
                    <tr>
                        <th colspan="4" class="pull-left" id="filtros_h">
                            <h3>Filtros</h3>
                        </th>
                    </tr>
		    <tr>
			<td scope="col" headers="filtros_h">
				{% set filtros = this.get_filtros %}
			    <label for="filtro_anio">A&ntilde;o acad&eacute;mico: </label>
			    <select id="filtro_anio" name="filtro_anio">
					<option value="">Todos</option>
					{% for clave, valor in datos_filtros.anios %}
					<option value="{{ clave }}" {% if filtros['anio_academico'] and filtros['anio_academico'] == valor %}selected="selected"{% endif %}>{{ valor }}</option>
					{% endfor %}
			    </select>
			</td>
			<td scope="col" headers="filtros_h">
				<label for="filtro_per_lectivo">Per&iacute;odo lectivo: </label>
				
				<select id="filtro_per_lectivo" name="filtro_per_lectivo">
			    <option value="">Todos</option>
				{% for clave, valor in datos_filtros.per_lec %}
				    <option value="{{ clave }}" {% if filtros['periodo_lectivo'] and filtros['periodo_lectivo'] == valor %}selected="selected"{% endif %}>{{ valor }}</option>
				{% endfor %}
			    </select>
			</td>
			<td scope="col" headers="filtros_h">
			    <label for="filtro_nombre_materia">Nombre de la materia: </label>				
			    <input type="text" id="filtro_nombre_materia" name="filtro_nombre_materia" value="{% if filtros['nombre'] %}{{ filtros['nombre'] }}{% endif %}" />
			</td>
			<td scope="col" style="padding-top: 14px;" headers="filtros_h">
			    <input type="submit" id="filtro_boton" name="filtro_boton" value="Ver actas" class="btn" />
			</td>
		    </tr>
		</table>
	    </form>
	</div>

	{% if this.data.datos or this.data.datos_corte %}
		{% import "kernel/macro_pager.twig" as pager %}
		<div class="pagination pagination-centered">
			{{ pager.render_paginator(this.get_paginas, this.get_pagina) }}
		</div>
	{% endif %}

	{% if this.data.datos or this.data.datos_corte %}
		<table class="table table-striped table-bordered table-condensed" summary="Tabla de actas, haga clic en la celda para ver">
			{% if this.get_corte %}
				{% for dato in this.data.datos_corte %}
					{% if dato.titulo_corte %}
					<tr>
						<td class="cc-titulo-nivel-0" colspan="{{this.data.cantidad_columnas}}">
							{{dato.titulo_corte}}
						</td>
					</tr>
					{% endif %}
					{% if dato.titulos %}
						<tr>
						{% for titulo in dato.titulos %}
							<th scope="col">{{titulo}}</th>
						{% endfor %}
						</tr>
					{% endif %}
					{% if dato.datos %}
						{% for clave, item in dato.datos %}
						<tr{% if (item.URL_LINEA) %} class="link-in-data" data-link="{{item.URL_LINEA}}"{% endif %}>
						{% for keyline, linea in item %}
							{% if (keyline != "URL_LINEA") %}
							<td {% if (loop.index==1) %}scope="row"{% endif %}>
								{{linea}}
							</td>
							{% endif %}
						{% endfor %}
						</tr>
						{% endfor %}

						{% if dato.funciones_pie_corte %}
						{% for funcion in dato.funciones_pie_corte %}
						<tr>
							{% for col_fn, titulo in dato.datos[0] %}
								{% if col_fn != this.data.corte.campo %}
								<td><strong>{{funcion[col_fn]}}</strong></td>
								{% endif %}
							{% endfor %}
						</tr>
						{% endfor %}
						{% endif %}

						{% if dato.mensaje_pie_corte %}								
						{% for funcion in dato.mensaje_pie_corte %}
						<tr>
							<td colspan="{{this.data.cantidad_columnas}}"><strong>{{funcion}}</strong></td>
						</tr>
						{% endfor %}
						{% endif %}
					{% endif %}
				{% endfor %}
			{% else %}
				<!-- Titulos -->
				<thead>
				<tr>
					{% if this.data.titulos %}
						{% for titulo in this.data.titulos %}
							<th scope="col">{{titulo}}</th>
						{% endfor %}					
					{% endif %}
				</tr>
				</thead>

				<!-- Datos -->
				{% for columnas in this.data.datos %}
				<tr>
					{% for keyline, columna in columnas %}
						{% if ((keyline != "URL_LINEA") and (keyline != "URL_PDF") and (keyline != "URL_XLS")) %}
							<td headers="{{keyline}}" {% if (loop.index==1) %}scope="row"{% endif %}{% if (columnas.URL_LINEA) %} class="link-in-data" data-link="{{columnas.URL_LINEA}}"{% endif %}>
								{{columna}}
							</td>
							{% endif %}					
					{% endfor %}
							
					<td headers="ACCIONES" style="width: 100px;">
					<a class="btn no-ajax" target="_blank" href="{{columnas.URL_PDF}}">
						<span class="acchide">Exportar a PDF</span>
						<span class="g3w-icono-pdf"></span>
					</a>
					<a class="btn no-ajax" target="_blank" href="{{columnas.URL_XLS}}">
						<span class="acchide">Exportar a XLS</span>
						<span class="g3w-icono-xls"></span>
					</a>
											
				</tr>
				{% endfor %}       
			{% endif %}
		</table>
	{% else %}
		<div role="alert" class="alert">
			{{"reporte.no_hay_datos.acta_promocion"|trans|capitalize}}
		</div>
	{% endif %}
{% endblock %}
