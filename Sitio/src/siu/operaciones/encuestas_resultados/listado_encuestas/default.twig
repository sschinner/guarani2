{% extends "kernel/pagelet.twig" %}
{% block contenido %}

    {% if this.data.encuestas_resultados %}

        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th class="centrado">{{ 'encuestas_resultados.titulo' | trans }}</th>
                    <th class="centrado">{{ 'encuestas_resultados.perido_lectivo' | trans }}</th>
                    <th class="centrado">{{ 'encuestas_resultados.encuestados' | trans }}</th>
                    <th class="centrado">{{ 'encuestas_resultados.respondidas' | trans }}</th>
                    <th class="centrado" style="white-space:nowrap;" >{{ 'encuestas_resultados.tipo_de_encuesta' | trans }}<i id="tipo_encuesta" data-title="{{ 'encuestas_resultados.nota_columna_tipo_encuesta' | trans }}" class="icon-info-sign"></i></th>
                    <th class="centrado"></th>
                </tr>
            </thead>

            <tbody>
                
                {% for encuesta_resultado in this.data.encuestas_resultados %}
                    
                    <tr>
                        <td>{{ encuesta_resultado.FORMULARIO_TITULO }}</td>
                        <td>{{ encuesta_resultado.PER_LECT_EXAMEN | capitalize }}</td>
                        <td id="total_encuestados">{{ encuesta_resultado.CANT_ENCUESTADOS }}</td>
                        <td id="total_respondidas">{{ encuesta_resultado.CANT_RESPONDIDAS }}</td>
                        <td id="tipo_encuesta">{{ encuesta_resultado.TIPO_ENCUESTA }}</td>
                        <td class="centrado">

                            {%if encuesta_resultado.CANT_ENCUESTADOS > 0 %}

                            <a class="btn btn-small btn-primary"
                            href="{{this.data.url_ver_bloques~'/'
                                       ~encuesta_resultado.KOLLA_ID_ENCUESTA_HASH~'/'
                                       ~encuesta_resultado.FORMULARIO_HASH~'/'
                                       ~encuesta_resultado.ELEMENTO_EXTERNO_HASH~'/'
                                       ~encuesta_resultado.KOLLA_ID_HABILITACION_HASH
                                       }}"
                            type="button" data-encuesta="{{ encuesta_resultado.ENCUESTA }}">
                            {{ 'encuestas_respondidas.ver' | trans }}
                            </a>

                            {%endif%}

                        </td>
                    </tr>
                    
                {% endfor %}
                
            </tbody>
        </table>
        <div id="codigo_recuperacion" class="modal hide fade"></div>
        <div id="encuesta_respondida_kolla" class="modal hide fade"></div>

    {% else %}

        <div class="alert">{{ 'encuestas_resultados.sin_resultados' | trans }}</div>

    {% endif %}

{% endblock %}

