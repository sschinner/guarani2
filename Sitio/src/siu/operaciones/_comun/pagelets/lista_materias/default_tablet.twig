{% extends "kernel/pagelet.twig" %}
{% block contenido %}
	{% spaceless %}
		<div id='listado_materias'>
			<ul class="nav nav-list">
			{% for materia in this.data %}
				{% set inscripto = (materia.E_INSCRIPCION) ? 'insc' : '' %}
				<li class='{{inscripto}}'>
					<a href='{{ materia.URL_MATERIA }}' title='{{ materia.MATERIA_NOMBRE }}'>
					({{ materia.MATERIA}}) {{ materia.MATERIA_NOMBRE|raw }}
					</a>
				</li>
			{% endfor %}
			</ul>
		</div>
	{% endspaceless %}
{% endblock %}
