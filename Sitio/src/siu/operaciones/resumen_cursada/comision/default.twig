{% extends "kernel/pagelet.twig" %}
{% block contenido %}
    <div class="titulo_operacion">
        <h2 class="clearfix">
            {% if this.data.tabla %}
            <div class="pull-right" >
                <a tabindex="0" id="pdf_btn" href="{{ this.data.url_pdf }}" target="_blank" class="btn no-ajax" title="{{ 'descargar_pdf'|trans|capitalize }}"><span class="acchide">{{'descargar_pdf'|trans|capitalize}}</span><span class="g3w-icono-pdf"></span></a>
                <a tabindex="0" id="xls_btn" href="{{ this.data.url_xls }}" target="_blank" class="btn no-ajax" title="{{ 'descargar_xls'|trans|capitalize }}"><span class="acchide">{{'descargar_xls'|trans|capitalize}}</span><span class="g3w-icono-xls"></span></a>
            </div> 
            {% endif %}
            <button class='btn btn-primary btn-small pull-left js-history-back' alt="Volver"><span class="icon-chevron-left icon-white"></span></button>
            <span class="pull-left">{{"resumen_cursada"|trans|capitalize}}</span>
        </h2>
    </div>
    {% if (this.data.encabezado) %}
    <table class="table table-condensed" summary="Informacion de acta">
		<tr>
			<td colspan="12"><strong>{{"resumen_cursada.comision.encabezado.materia"|trans|capitalize}}: </strong>{{this.data.encabezado.MATERIA_NOMBRE}}</td>
		</tr>
		<tr>
			<td><strong>{{"resumen_cursada.comision.encabezado.comision"|trans|capitalize}}:</strong> {{this.data.encabezado.COMISION_NOMBRE}}</td>
			<td><strong>{{"resumen_cursada.comision.encabezado.anio_acad"|trans|capitalize}}:</strong> {{this.data.encabezado.ANIO_ACADEMICO}}</td>
			<td><strong>{{"resumen_cursada.comision.encabezado.periodo"|trans|capitalize}}: </strong> {{this.data.encabezado.PERIODO_LECTIVO}}</td>
		</tr>
	</table>
    {% endif %}
    {% if (this.data.tabla) %}
    <table class="table table-striped table-bordered table-condensed" summary="Tabla de comisiones, haga clic en la celda para ver">
        <thead id="encabezado">
            {% if this.data.parciales or this.data.tiene_actas %}
            <tr id="primer-encabezado">
                <th colspan="2" ></th>             
                {% if (this.data.parciales) %}
                    {% for parcial in this.data.parciales %}
                    <th>{{ parcial.EVALUACION_DESC }} <br> {{parcial.SFECHA_PARCIAL }}</th>
                    {% endfor %}
                {% endif  %}
                
                {% if (this.data.tiene_actas) %}
                    <th colspan="3">{{"resumen_cursada.comision.encabezado.acta_cursadas"|trans|capitalize}}<br>Nro {{this.data.ACTA}}</th>
                {% endif %}
            </tr>       
            {% endif %}
            <tr>
                <th id="col-nombre">{{"resumen_cursada.comision.encabezado.alumno"|trans|capitalize}}</th>
                <th>{{"resumen_cursada.comision.encabezado.legajo"|trans|capitalize}}</th>
                
                {% if (this.data.parciales) %}
                    {% for parcial in this.data.parciales %}
                        <th>{{"resumen_cursada.comision.encabezado.nota"|trans|capitalize}}</th>
                    {% endfor %}
                {% endif  %}
                {% if (this.data.tiene_actas) %}
                    <th>{{"resumen_cursada.comision.encabezado.cond_reg"|trans|capitalize}}</th>
                    <th>{{"resumen_cursada.comision.encabezado.nota"|trans|capitalize}}</th>
                    <th>{{"resumen_cursada.comision.encabezado.resultado"|trans|capitalize}}</th>
                {% endif %}
            </tr>
        </thead>
        
        <tbody>
        {% for linea in this.data.tabla %}
        <tr>
            <td>{{ linea.ALUMNO }}</td>
            <td>{{ linea.LEGAJO }}</td>

            {% if (linea.PARCIALES) %}
            {% for parcial in linea.PARCIALES %}
            <td style="text-align: center;">{{parcial.NOTA}}</td>
            {% endfor %}
            {% endif  %}
           
            {% if (linea.ACTA) %}
            <td>{{linea.ACTA.COND_REG}}</td>
            <td>{{linea.ACTA.NOTA}}</td>
            <td>{{linea.ACTA.RESULTADO}}</td>
            {% endif  %}
        </tr>
        {% endfor %}
        </tbody>
    </table>
    {% if this.data.ESTADO_ACTA == "A" %}
    <p>{{'resumen_cursada.comision.nota.acta_abierta' | trans | capitalize }}</p>
    {% endif %}
    {% else %}
        <div role="alert" class="alert">
            {{"resumen_cursada.comision.sin_resultados"|trans|capitalize}}
        </div>
    {% endif %}
{% endblock %}