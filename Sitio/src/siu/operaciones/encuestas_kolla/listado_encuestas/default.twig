{% extends "kernel/pagelet.twig" %}
{% block contenido %}
	<div class="well">
		<ul class="nav nav-list">
		{% for id, encuesta in this.data.links_encuesta %}
			<li class="encuesta">
				{% if encuesta.desplegar_encuestas %}
					<div>
						<h5 class="colapsar">{{ encuesta.titulo }}</h5>
						<ul class="hide nav nav-list">
						{% for encuesta_item in encuesta.encuestas %}
							<li><a id='{{ encuesta_item.id_eliminacion }}' href='{{ encuesta_item.link_encuesta }}' >{{  encuesta_item.alcance_titulo }}</a></li>
						{% endfor %}
						</ul>
					</div>
				{% else %}
					<a id='{{ encuesta.id_eliminacion }}' href='{{ encuesta.link_encuesta }}' >{{  encuesta.item_titulo }}</a>
				{% endif %}
			</li>
		{% endfor %}
		</ul>
	</div>
{% endblock %}
