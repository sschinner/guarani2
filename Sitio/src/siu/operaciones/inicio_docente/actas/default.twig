{% extends "kernel/pagelet.twig" %}
{% block contenido %}
<h3>{{'actas_abiertas'|trans|capitalize}}</h3>
{% if this.data.actas_cursadas or  this.data.actas_examenes%}
	<table class="table table-striped table-bordered table-condensed" summary="tabla de actas abiertas, haga clic en la celda para ir">
	{% if this.data.actas_cursadas %}
		<th colspan="3">{{ 'cursadas'|trans|capitalize }}</th>
	
		{% for acta in this.data.actas_cursadas %}
			<tr>
			<td><a href='{{ acta.LINK }}'>{{ acta.ACTA_REG }}</a></td>
			<td>
				<div>{{ acta.PERIODO_LECTIVO }} - {{ acta.ANIO_ACADEMICO }}<div>
				<div>{{ acta.MATERIA_NOMBRE }}</div>
			</td>
			<td class='columna-accion'>
				<div class='wrapper-carga'>
				<div class='progreso-carga' style='width: {{ acta.PORCENTAJE ~ '%' }}'></div>
				</div>
					{{ acta.PORCENTAJE ~ '%' }}
					<a class="btn btn-mini" href="{{ acta.LINK }}">{{"carga" | trans | capitalize }}</a>
			</td>
			</tr>
		{% endfor %}
	{% endif %}


	{% if this.data.actas_examenes %}
		<th colspan="3">{{ 'examenes'|trans|capitalize }}</th>
		{% for acta in this.data.actas_examenes %}
			<tr data-link='{{ acta.LINK }}' class='link-in-data'>
				<td><a href='{{ acta.LINK }}'>{{ acta.ACTA }}</a></td>
				<td>

					<div>{{ acta.DIA ~ ' - ' ~ acta.HORA }}	</div>
					<div>{{ acta.MATERIA_NOMBRE }} </div>
				</td>
				<td>
					<div class='wrapper-carga'>
						<div class='progreso-carga' style='width: {{ acta.PORCENTAJE ~ '%' }}'></div>
					</div>
					{{ acta.PORCENTAJE ~ '%' }}
					<a class="btn btn-mini" href="{{ acta.LINK }}">{{"carga" | trans | capitalize }}</a>
				</td>
			</tr>
		{% endfor %}
		</table>
	{% endif %}
	</table>
{% else %}
	<div class="alert">{{ 'no_hay_actas'|trans|capitalize }}</div>
{% endif %}
	
	
{% endblock %}
	