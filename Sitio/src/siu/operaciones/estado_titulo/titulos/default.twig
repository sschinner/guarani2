{% extends "kernel/pagelet.twig" %}
{% block contenido %}
	<div class="titulo_operacion">
		<h2 class="clearfix"><span class="pull-left">{{"header.menu.estado_titulo"|trans|capitalize}}</span>
			<div class="pull-right">
				<a class="btn no-ajax" target="_blank" href="{{this.data.url.generar_pdf}}"><span class="acchide">{{'descargar_pdf'|trans|capitalize}}</span><span class="g3w-icono-pdf"></span></a>
				<a class="btn no-ajax" target="_blank" href="{{this.data.url.generar_excel}}"><span class="acchide">{{'descargar_xls'|trans|capitalize}}</span><span class="g3w-icono-xls"></span></a>
			</div>
		</h2>
	</div>
		{% if (this.data.titulos) %}
		{% for carrera in this.data.titulos %}
			<table class="table table-condensed table-bordered">
				<tr>
					<th>{{"carrera"|trans|capitalize}}</th>
					<td>{{ carrera.carrera }}</td>
				</tr>
				<tr>
					<th>{{"legajo"|trans|capitalize}}</th>
					<td>{{ carrera.legajo }}</td>
				</tr>
				<tr>
					<th>{{"plan"|trans|capitalize}}</th>
					<td>{{ carrera.plan }}</td>
				</tr>
				<tr>
					<th>{{"titulo"|trans|capitalize}}</th>
					<td>{{ carrera.titulo }}</td>
				</tr>
				<tr>
					<th>{{"fecha_egreso"|trans|capitalize}}</th>
					<td>{{ carrera.fecha_egreso }}</td>
				</tr>
				<tr>
					<th>{{"fecha_jura"|trans|capitalize}}</th>
					<td>{{ carrera.fecha_jura }}</td>
				</tr>
			</table>	

			<table class='table table-condensed table-hover table-striped'>
				<thead>
					<tr>
						<th>{{'fecha'|trans| capitalize}}</th>
						<th>{{'expediente'|trans| capitalize}}</th>
						<th>{{'estado'|trans| capitalize}}</th>
						<th>{{'promedio con aplazos'|trans| capitalize}}</th>
						<th>{{'promedio sin aplazos'|trans| capitalize}}</th>
					</tr>
				</thead>
				<tbody>
					{% for tramite in carrera.tramites %}
					<tr>
						<td>{{tramite.fecha}}</td>
						<td>{{tramite.expediente}}</td>
						<td>{{tramite.estado}}</td>
						<td>{{tramite.promedio_c_aplazos}}</td>
						<td>{{tramite.promedio_s_aplazos}}</td>
					</tr>
				{% endfor %}					
					</tbody>
				</table>
			<div></div>	
		{% endfor %}
	{% else %}
		<div class="alert">
			{{"reporte.no_hay_datos.estado_titulo"|trans|capitalize}}
		</div>
	{% endif %}

{% endblock %}
