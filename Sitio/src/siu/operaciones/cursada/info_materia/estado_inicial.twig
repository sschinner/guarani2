{#
	Entrada:  inscripciones, mensajes, csrf
#}

<div>
	<h3>{{ 'comenzar_inscripcion'|trans|capitalize }}</h3>
	<p><span class="icon-arrow-left"></span> {% trans %}parrafo.inscripcion.uso{% endtrans %}</p>
	{% if mensajes %}
		{% import "kernel/macro_notificaciones.twig" as notificaciones %}
		{{ notificaciones.render_notif(mensajes) }}
	{% endif %}
	{% if inscripciones %}

		<h4>{{ 'inscripciones_activas'|trans|capitalize }}</h4>
		<span class='js-csrf hide' data-csrf='{{csrf}}'/>
		<table class="table table-striped table-condensed" summary="Tabla con materias a las que estas inscripto, con nombre de materia y acci&oacute;n de dar de baja.">
			{% for inscripcion in inscripciones %}
			<tr class='js-mis-inscripciones'>
				<td scope="row">{{inscripcion.materia}}</td>
				<td>
					{% if param_insc_cur_bajas %}	
						<button
						class="js-baja-inicial btn btn-mini btn-warning pull-right" type="button"
						data-materia="{{inscripcion.url_materia}}"
						data-comision="{{inscripcion.url_comision}}"
						>
						{{'dar_baja'|trans|capitalize}}
						</button>
					{% endif %}		
				</td>
			</tr>
			{% endfor %}
		</table>
	{% endif %}
</div>