{# Se muestra el pagelet notificaciones si está activado y no hay un error del control inicial #}
{% extends notificaciones and not error ? "kernel/barra_lateral_dos_columnas.twig" : "kernel/dos_columnas.twig" %}
{% block titulo_operacion %}
	<h2>{{"inscripcion_a_materias"|trans|capitalize}}</h2>
	{% if hay_mensajes %}
		{% import "kernel/macro_notificaciones.twig" as notificaciones %}
		{{ notificaciones.render_notif(mensajes, error) }}
	{% endif %}
{% endblock %}
{% block columna_1 %}
	{{ this.render_pagelet('lista_materias') }}
{% endblock %}
{% block columna_2 %}
	{{ this.render_pagelet('info_materia') }}
{% endblock %}
{% block columna_3 %}
	{% if notificaciones %}
		{{ this.render_pagelet('notificaciones') }}
	{% endif %}
{% endblock %}