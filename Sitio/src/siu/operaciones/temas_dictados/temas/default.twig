{% extends "kernel/pagelet.twig" %}
{% block contenido %}
	<div class="titulo_operacion">
		<h2 class="clearfix">
			<button class='btn btn-primary btn-small js-btn-back pull-left' data-url-back="{{this.data.url_back}}" alt="Volver"><span class="icon-chevron-left icon-white"></span></button>
			<span class="pull-left">{{"tit_temas_dictados"|trans|capitalize}}</span>
			<div class="pull-right">
				<a class="btn no-ajax" target="_blank" href="{{this.data.url.generar_pdf}}"><span class="acchide">{{'descargar_pdf'|trans|capitalize}}</span><span class="g3w-icono-pdf"></span></a>
				<a class="btn no-ajax" target="_blank" href="{{this.data.url.generar_excel}}"><span class="acchide">{{'descargar_xls'|trans|capitalize}}</span><span class="g3w-icono-xls"></span></a>
			</div>
		</h2>
	</div>
	<table class="table table-striped table-bordered table-condensed" summary="{{'temas_dictados.temas_summary'|trans|capitalize}}" tabindex="0">
		{% for indice, corte in this.data.datos %}
			{% if corte.datos %}
				<tr>
					<th colspan="5">
					<h4>{{"nombre_comision" |trans|capitalize}}: {{this.data.nombre_comision}} {% if corte.subcomision %}{{"subcomision" |trans|capitalize}}: {{corte.subcomision}}{% endif %}</h4>
					</th>
				</tr>
				<tr>
					<th style="width: 150px" scope="col">{{"temas_dictados.fecha" | trans | capitalize}}</th>
					<th style="width: 100px"  scope="col">{{"temas_dictados.inicio" | trans | capitalize}} - {{"temas_dictados.fin" | trans | capitalize}}</th>
					{# <th scope="col">{{"temas_dictados.fin" | trans | capitalize}}</th> #}
					<th style="width: 50px"  scope="col">{{"temas_dictados.horas" | trans | capitalize}}</th>
					<th scope="col">{{"temas_dictados.tema" | trans | capitalize}}</th>
					<th scope="col">{{"temas_dictados.tipo_clase" | trans | capitalize}}</th>
				</tr>
				{% for valor in corte.datos %}
				<tr>
					<td scope="row">
						{{valor.fecha}}
					</td>
					<td>
						{{valor.inicio}}
					</td>
					{#<td>
						{{valor.fin}}
					</td>#}
					<td>
						{{valor.horas}}
					</td>
					<td>
						{{valor.tema}}
					</td>
					<td>
						{{valor.tipo_clase}}
					</td>
				</tr>
				{% endfor %}
			{% else %}
				<tr>
					<td colspan="5">
						{{"reporte.no_hay_datos.temas"|trans|capitalize}}
					</td>
				</tr>
			{% endif %}
		{% endfor %}
	</table>
{% endblock %}