{% macro cursada(datos) %}
	<table class='table table-condensed table-hover table-striped'>
		<thead>
			<tr>
				<th>{{'actas.cuadro.acta'|trans|capitalize}}</th>
				<th>{{'actas.cuadro.anio_academico'|trans|capitalize}}</th>
				<th>{{'actas.cuadro.periodo_lectivo'|trans|capitalize}}</th>
				<th>{{'actas.cuadro.sede'|trans|capitalize}}</th>
				<th>{{'actas.cuadro.materia'|trans|capitalize}}</th>
				<th>{{'actas.cuadro.estado'|trans|capitalize}}</th>
				<th>{{'actas.cuadro.fecha_cierre'|trans|capitalize}}</th>
			</tr>
		</thead>
		<tbody>
			{% for cursada in datos %}
				<tr class="link-in-data" data-link="{{cursada.LINK}}">
					<td>{{cursada.ACTA}}</td>
					<td>{{cursada.ANIO_ACADEMICO}}</td>
					<td>{{cursada.TURNO_PERIODO}}</td>
					<td>{{cursada.SEDE_NOMBRE}}</td>
					<td>{{cursada.MATERIA_NOMBRE}} ({{cursada.MATERIA}})</td>
					<td>{{cursada.ESTADO_DESC}}</td>
					<td>{{cursada.FECHA_CIERRE}}</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>
{% endmacro %}

