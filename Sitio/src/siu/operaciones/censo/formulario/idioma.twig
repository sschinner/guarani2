{% extends "kernel/pagelet.twig" %}
{% block contenido %}
	<form id="idioma" action="{{this.data.form.getAction}}" method="post">
		{% import "kernel/macro_csrf.twig" as input_csrf %}
		{{ input_csrf.mostrar(this.generar_csrf) }}
		<fieldset>
			<legend class="clearfix">
				<span class="pull-left"><h3 id="form-title" class="resaltar">Idiomas</h3></span>
				<button style="margin-top: 2px;" type="button" name="guardar" class="guardar btn btn-info pull-right" disabled="disabled">{{'guardar' |trans|capitalize}}</button>
			</legend>

		{{this.data.form.form_id.renderViewHelper|raw}}

	<div class="clearfix bloque">
		<fieldset>
			<legend>
				{{this.data.form.AUX2_ALU_IDIOMA_INGL.renderLabel|raw}}
			</legend>
			<div class="pull-left">
                            {{this.data.form.AUX2_ALU_IDIOMA_INGL.renderViewHelper|raw}}
                        </div>
		</fieldset>
	</div>

	<div class="clearfix bloque">
		<fieldset>
			<legend>
				{{this.data.form.AUX2_ALU_IDIOMA_ALEM.renderLabel|raw}}
			</legend>
				<div class="pull-left">{{this.data.form.AUX2_ALU_IDIOMA_ALEM.renderViewHelper|raw}}</div>
		</fieldset>
	</div>

	<div class="clearfix bloque">
		<fieldset>
				<legend>
					{{this.data.form.AUX2_ALU_IDIOMA_FRAN.renderLabel|raw}}
				</legend>
				<div class="pull-left">{{this.data.form.AUX2_ALU_IDIOMA_FRAN.renderViewHelper|raw}}</div>
		</fieldset>
	</div>

	<div class="clearfix bloque">
		<fieldset>
			<legend>
				{{this.data.form.AUX2_ALU_IDIOMA_ITAL.renderLabel|raw}}
			</legend>
			<div class="pull-left">{{this.data.form.AUX2_ALU_IDIOMA_ITAL.renderViewHelper|raw}}</div>
		</fieldset>
	</div>

	<div class="clearfix bloque">
		<fieldset>
			<legend>
				{{this.data.form.AUX2_ALU_IDIOMA_PORT.renderLabel|raw}}
			</legend>
				<div class="pull-left">{{this.data.form.AUX2_ALU_IDIOMA_PORT.renderViewHelper|raw}}</div>
		</fieldset>
	</div>

		<div class="clearfix bloque">
			<div class="pull-left">{{this.data.form.AUX2_ALU_IDIOMA_OTRO.renderLabel|raw}}</div>
			<div class="pull-left">{{this.data.form.AUX2_ALU_IDIOMA_OTRO.renderViewHelper|raw}}</div>
		</div>

		</fieldset>
	</form>
	<button type="button" name="guardar" class="guardar btn btn-info pull-right" disabled="disabled">{{'guardar' |trans|capitalize}}</button>
{% endblock %}