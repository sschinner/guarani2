{% extends "kernel/pagelet.twig" %}
{% block contenido %}
	<form id="trabajo" action="{{this.data.form.getAction}}" method="post">
		{% import "kernel/macro_csrf.twig" as input_csrf %}
		{{ input_csrf.mostrar(this.generar_csrf) }}

		<fieldset>
			<legend class="clearfix">
				<span class="pull-left"><h4 id="form-title" class="resaltar">{{'censo.situacion_laboral'|trans|capitalize}}</h4></span>
				<button style="margin-top: 2px;" type="button" name="guardar" class="guardar btn btn-info pull-right" disabled="disabled">{{'guardar' |trans|capitalize}}</button>
			</legend>

		{{this.data.form.form_id.renderViewHelper|raw}}

		{{this.data.form.AUX1_EXISTE_TRAB_ALUM.renderLabel|raw}}
		{{this.data.form.AUX1_EXISTE_TRAB_ALUM.renderViewHelper|raw}}

		<div class="js-datos-trabajo">
			<div class="clearfix">
				<div class="pull-left">
					{{this.data.form.CENS_ANTIGUEDAD.renderLabel|raw}}
					{{this.data.form.CENS_ANTIGUEDAD.renderViewHelper|raw}}
				</div>
			</div>
			<div class="clearfix">
				<div class="pull-left">
					{{this.data.form.CENS_EMPRESA.renderLabel|raw}}
					{{this.data.form.CENS_EMPRESA.renderViewHelper|raw}}
				</div>
				<div class="pull-left">
					{{this.data.form.CENS_EMPRESA_OTRA.renderLabel|raw}}
					{{this.data.form.CENS_EMPRESA_OTRA.renderViewHelper|raw}}
				</div>
			</div>
			<div class="clearfix">
				<div class="pull-left">
					{{this.data.form.CENS_SECTOR.renderLabel|raw}}
					{{this.data.form.CENS_SECTOR.renderViewHelper|raw}}
				</div>
				<div class="pull-left">
					{{this.data.form.CENS_SUBSECTOR.renderLabel|raw}}
					{{this.data.form.CENS_SUBSECTOR.renderViewHelper|raw}}
				</div>
			</div>
			<div class="clearfix">
				<div class="pull-left">
					{{this.data.form.CENS_FACILIDAD_EST_EMP.renderLabel|raw}}
					{{this.data.form.CENS_FACILIDAD_EST_EMP.renderViewHelper|raw}}
				</div>
				<div class="pull-left">
					{{this.data.form.CENS_FACILIDAD_EST_INST.renderLabel|raw}}
					{{this.data.form.CENS_FACILIDAD_EST_INST.renderViewHelper|raw}}
				</div>
			</div>
			<div class="clearfix">
				<div class="pull-left">
					{{this.data.form.AUX2_ALU_TRAB_OCUP.renderLabel|raw}}
					{{this.data.form.AUX2_ALU_TRAB_OCUP.renderViewHelper|raw}}
				</div>
				<div class="pull-left">
					{{this.data.form.CENS_HORA_SEM_TRAB_ALUM.renderLabel|raw}}
					{{this.data.form.CENS_HORA_SEM_TRAB_ALUM.renderViewHelper|raw}}
				</div>
			</div>
			<div class="clearfix">
				<div class="pull-left">
					{{this.data.form.AUX2_ALU_TRAB_TAREA.renderLabel|raw}}
					{{this.data.form.AUX2_ALU_TRAB_TAREA.renderViewHelper|raw}}
				</div>
				<div class="pull-left">
					{{this.data.form.AUX2_ALU_TRAB_HACE.renderLabel|raw}}
					{{this.data.form.AUX2_ALU_TRAB_HACE.renderViewHelper|raw}}
				</div>
			</div>
			<div class="clearfix">
				<div class="pull-left">
					{{this.data.form.CENS_REL_TRAB_CARRERA.renderLabel|raw}}
					{{this.data.form.CENS_REL_TRAB_CARRERA.renderViewHelper|raw}}
				</div>
			</div>
		</div>

		<h2 class="resaltar divisor">{{'censo.datos_adicionales'|trans|capitalize}}</h2>

		<div id="datos_trabajo_adicionales" class="clearfix">
			{{this.data.form.AUX2_ALU_TRAB_DESJUB.renderLabel|raw}}
			{{this.data.form.AUX2_ALU_TRAB_DESJUB.renderViewHelper|raw}}

			{{this.data.form.AUX2_ALU_TRAB_FAMI.renderLabel|raw}}
			{{this.data.form.AUX2_ALU_TRAB_FAMI.renderViewHelper|raw}}

			{{this.data.form.AUX1_REMUNERACION.renderLabel|raw}}
			{{this.data.form.AUX1_REMUNERACION.renderViewHelper|raw}}
		</div>
		</fieldset>
	</form>
	<button type="button" name="guardar" class="guardar btn btn-info pull-right" disabled="disabled">{{'guardar' |trans|capitalize}}</button>
{% endblock %}