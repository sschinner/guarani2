{% extends "kernel/pagelet.twig" %}
{% import "macro_ficha_alumno.twig" as ficha_alumno %}
{% block contenido %}
    {{ ficha_alumno.render_menu(this.data.menu_reportes, this.data.categoria_actual, this.data.reporte_actual) }}
	<div id="reporte_contenido">
		<h3>{{ 'ficha_alumno.rep_sanciones' | trans | capitalize }}</h3>
		{% if (this.data.datos) %}

		<table class='table table-condensed table-hover table-striped'>
			<thead>
				<tr>
					<th>{{'ficha_alumno.rep_sanciones.tipo_sancion'|trans| capitalize}}</th>
					<th>{{'ficha_alumno.rep_sanciones.resolucion'|trans| capitalize}}</th>
					<th>{{'ficha_alumno.rep_sanciones.desde'|trans| capitalize}}</th>
					<th>{{'ficha_alumno.rep_sanciones.hasta'|trans| capitalize}}</th>
					<th>{{'ficha_alumno.rep_sanciones.estado'|trans| capitalize}}</th>	
					<th>{{'ficha_alumno.rep_sanciones.resolucion_de_cancelacion'|trans| capitalize}}</th>	
					<th>{{'ficha_alumno.rep_sanciones.fecha_de_cancelacion'|trans| capitalize}}</th>
					<th>{{'ficha_alumno.rep_sanciones.afecta'|trans| capitalize}}</th>
				</tr>
			</thead>
			<tbody>
				{% for linea in this.data.datos %}
					<tr>
						<td>{{ficha_alumno.mostrar(linea.tipo_sancion)}}</td>
						<td>{{ficha_alumno.mostrar(linea.resolucion)}}</td>
						<td>{{ficha_alumno.formatear_fecha(linea.fecha_desde)}}</td>
						<td>{{ficha_alumno.formatear_fecha(linea.fecha_hasta)}}</td>
						<td>{{ficha_alumno.mostrar(linea.estado)}}</td>
						<td>{{ficha_alumno.mostrar(linea.resolucion_cancelacion)}}</td>
						<td>{{ficha_alumno.formatear_fecha(linea.fecha_cancelacion)}}</td>
						<td>{{ficha_alumno.mostrar(linea.afecta)}}</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
		{% else %}
		<div class="alert alert-block">{{'ficha_alumno.no_hay_informacion'|trans| capitalize}}</div>
		{% endif %}
	</div>
{% endblock %}
