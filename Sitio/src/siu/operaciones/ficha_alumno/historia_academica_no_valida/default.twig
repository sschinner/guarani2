{% extends "kernel/pagelet.twig" %}
{% import "macro_ficha_alumno.twig" as ficha_alumno %}
{% block contenido %}
    {{ ficha_alumno.render_menu(this.data.menu_reportes, this.data.categoria_actual, this.data.reporte_actual) }}
	<div id="reporte_contenido">
		<h3>{{ 'ficha_alumno.rep_historia_academica_no_valida' | trans }}</h3>
		{% for carrera_orden, carrera in this.data.carreras %}
		
			<ul class="ficha_alumno_ul">
				
					<li><strong>{{ 'ficha_alumno.carrera' | trans | capitalize }}:</strong> {{ficha_alumno.mostrar(carrera.carrera)}}</li>
					<li><strong>{{ 'ficha_alumno.legajo' | trans | capitalize }}:</strong> {{ficha_alumno.mostrar(carrera.legajo)}}</li>
					
			</ul>
			{% if carrera.historias %}
				<table class='table table-condensed table-hover table-striped'>
						<thead>
							<tr>
								<th>{{'ficha_alumno.materia'|trans|capitalize}}</th>
								<th>{{'ficha_alumno.plan'|trans|capitalize}}</th>
								<th>{{'ficha_alumno.fecha'|trans|capitalize}}</th>
								<th>{{'ficha_alumno.nota'|trans|capitalize}}</th>
								<th>{{'ficha_alumno.resultado'|trans|capitalize}}</th>
								<th>{{'ficha_alumno.aprobacion'|trans|capitalize}}</th>
								<th>{{'ficha_alumno.acta_o_resolucion'|trans|capitalize}}</th>
								<th>{{'ficha_alumno.estado_de_la_nota'|trans|capitalize}}</th>
							</tr>
						</thead>
						<tbody>
							{% for linea, historia in carrera.historias %}
								<tr data-linea="{{carrera_orden}}{{linea}}" class="detalle">
									<td class="col_izq">{{ficha_alumno.mostrar(historia.materia)}}</td>
									<td>{{ficha_alumno.mostrar(historia.plan)}}</td>
									<td>{{ficha_alumno.mostrar(historia.fecha)}}</td>
									<td>{{ficha_alumno.mostrar(historia.nota)}}</td>
									<td>{{ficha_alumno.mostrar(historia.resultado)}}</td>
									<td>{{ficha_alumno.mostrar(historia.aprobacion)}}</td>
									<td>{{ficha_alumno.mostrar(historia.acta_o_resolucion)}}</td>
									<td>{{ficha_alumno.mostrar(historia.estado_de_la_nota)}}</td>
								</tr>
								<tr class="hide" id="detalle-{{carrera_orden}}{{linea}}">
									<td colspan="8">
										<ul>
											<li><strong>{{'ficha_alumno.motivo'|trans|capitalize}}:</strong> {{historia.desc_abreviada_movimiento}}</li>
											<li><strong>{{'ficha_alumno.fecha'|trans|capitalize}}:</strong> {{historia.fecha_movimiento}}</li>
											<li><strong>{{'ficha_alumno.nro_resolucion'|trans|capitalize}}:</strong> {{historia.nro_resolucion_movimiento}}</li>
											<li><strong>{{'ficha_alumno.obs'|trans|capitalize}}:</strong> {{historia.observaciones_movimiento}}</li>
										</ul>
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
			{% else %}
				<div class="alert text-warning">{{'ficha_alumno.no_hay_movimientos'|trans}}</div>
			{% endif %}
		
		{% else %}
			<div class="alert text-warning">{{'ficha_alumno.no_hay_informacion'|trans}}</div>
		{% endfor %}
	</div>
{% endblock %}
