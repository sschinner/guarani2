{% extends "kernel/pagelet.twig" %}
{% import "macro_ficha_alumno.twig" as ficha_alumno %}
{% block contenido %}
    {{ ficha_alumno.render_menu(this.data.menu_reportes, this.data.categoria_actual, this.data.reporte_actual) }}
	<div id="reporte_contenido">
		<h3>{{ 'ficha_alumno.rep_titulos' | trans }}</h3>
		{% if (this.data.datos) %}
		{% for carrera in this.data.datos %}
			<ul class="ficha_alumno_ul">
				<li><strong>{{ 'ficha_alumno.rep_titulos.carrera' | trans | capitalize }}:</strong> {{'('~ficha_alumno.mostrar(carrera.carrera)~')'~ficha_alumno.mostrar(carrera.carrera_nombre)}}</li>
				<li><strong>{{ 'ficha_alumno.rep_titulos.legajo' | trans | capitalize }}:</strong> {{ficha_alumno.mostrar(carrera.legajo)}}</li>
				<li><strong>{{ 'ficha_alumno.rep_titulos.plan' | trans | capitalize }}:</strong> {{ficha_alumno.mostrar(carrera.plan)}}</li>
				<li><strong>{{ 'ficha_alumno.rep_titulos.version' | trans | capitalize }}:</strong> {{ficha_alumno.mostrar(carrera.version)}}</li>
			</ul>
			<table class='table table-condensed table-hover table-striped'>
				<thead>
					<tr>
						<th>{{'ficha_alumno.rep_titulos.titulo'|trans| capitalize}}</th>
						<th>{{'ficha_alumno.rep_titulos.fecha_egreso'|trans| capitalize}}</th>
						<th>{{'ficha_alumno.rep_titulos.expediente'|trans| capitalize}}</th>
						<th>{{'ficha_alumno.rep_titulos.estado_tramite'|trans| capitalize}}</th>
					</tr>
				</thead>
				<tbody>
					{% for titulo in carrera.titulos %}
					<tr>
						<td class="col_izq">{{'('~ficha_alumno.mostrar(titulo.titulo)~')'~ficha_alumno.mostrar(titulo.titulo_nombre)}}</td>
						<td>{{ficha_alumno.mostrar(titulo.fecha)}}</td>
						<td>{{ficha_alumno.mostrar(titulo.expediente)}}</td>
						<td>{{ficha_alumno.mostrar(titulo.estado_nombre)}}</td>
					</tr>
				{% endfor %}					
					</tbody>
				</table>
		{% endfor %}
		
		{% else %}
		<div class="alert alert-block">{{'ficha_alumno.no_hay_informacion'|trans| capitalize}}</div>
		{% endif %}
	</div>
{% endblock %}
