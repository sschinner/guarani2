{% extends "kernel/pagelet.twig" %}
{% import "macro_ficha_alumno.twig" as ficha_alumno %}
{% block contenido %}
    {{ ficha_alumno.render_menu(this.data.menu_reportes, this.data.categoria_actual, this.data.reporte_actual) }}
	<div id="reporte_contenido">
		<h3>{{ 'ficha_alumno.rep_promedios' | trans | capitalize }}</h3>
		
		{% if (this.data.datos) %}
		<table class='table table-condensed table-hover table-striped'>
			<thead>
				<tr>
					<th>{{'ficha_alumno.carrera'|trans|capitalize}}</th>
					<th>{{'ficha_alumno.plan'|trans|capitalize}}</th>
					<th>{{'ficha_alumno.legajo'|trans|capitalize}}</th>
					<th>{{'ficha_alumno.promedio_con_aplazos'|trans|capitalize}}</th>
					<th>{{'ficha_alumno.promedio_sin_aplazos'|trans|capitalize}}</th>
				</tr>
			</thead>
			<tbody>
				{% for dato in this.data.datos %}
					<tr>
						<td>{{ficha_alumno.mostrar('('~dato.carrera~') '~dato.carrera_nombre)}}</td>
						<td>{{ficha_alumno.mostrar(dato.plan)}}</td>
						<td>{{ficha_alumno.mostrar(dato.legajo)}}</td>
						<td>{{ficha_alumno.mostrar(dato.promedio_con_aplazos)}}</td>
						<td>{{ficha_alumno.mostrar(dato.promedio_sin_aplazos)}}</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
		{% else %}
			<div class="alert text-warning">{{'ficha_alumno.no_hay_informacion'|trans}}</div>
		{% endif %}
	</div>
{% endblock %}
