{% extends "kernel/pagelet.twig" %}
{% import "macro_ficha_alumno.twig" as ficha_alumno %}
{% block contenido %}
    {{ ficha_alumno.render_menu(this.data.menu_reportes, this.data.categoria_actual, this.data.reporte_actual) }}
	<div id="reporte_contenido">
		<h3>{{ 'ficha_alumno.rep_inscripciones_examenes' | trans }}</h3>
		{% if (this.data.datos) %}
		{% for carrera in this.data.datos %}
			<ul class="ficha_alumno_ul">
				<li><strong>{{ 'ficha_alumno.rep_inscripciones_examenes.carrera' | trans | capitalize }}:</strong> {{'('~ficha_alumno.mostrar(carrera.carrera)~')'~ficha_alumno.mostrar(carrera.carrera_nombre)}}</li>
				<li><strong>{{ 'ficha_alumno.rep_inscripciones_examenes.legajo' | trans | capitalize }}:</strong> {{ficha_alumno.mostrar(carrera.legajo)}}</li>
			</ul>			
			<table class='table table-condensed table-hover table-striped'>
				<thead>
					<tr>
						<th>{{'ficha_alumno.rep_inscripciones_examenes.materia'|trans| capitalize}}</th>
						<th>{{'ficha_alumno.rep_inscripciones_examenes.turno'|trans| capitalize}}</th>
						<th>{{'ficha_alumno.rep_inscripciones_examenes.llamado'|trans| capitalize}}</th>
						<th>{{'ficha_alumno.rep_inscripciones_examenes.mesa'|trans| capitalize}}</th>
						<th>{{'ficha_alumno.rep_inscripciones_examenes.tipo_inscripcion'|trans| capitalize}}</th>
						<th>{{'ficha_alumno.rep_inscripciones_examenes.estado'|trans| capitalize}}</th>
						<th>{{'ficha_alumno.rep_inscripciones_examenes.nro_transaccion'|trans| capitalize}}</th>
					</tr>
				</thead>
				<tbody>
					{% for examen in carrera.examenes %}
					<tr>
						<td class="col_izq">{{'('~ficha_alumno.mostrar(examen.materia)~')'~ficha_alumno.mostrar(examen.materia_nombre)}}</td>
						<td>{{ficha_alumno.mostrar(examen.turno)}}</td>
						<td>{{ficha_alumno.mostrar(examen.llamado)}}</td>
						<td>{{ficha_alumno.mostrar(examen.mesa)}}</td>
						<td>{{ficha_alumno.mostrar(examen.tipo_inscripcion)}}</td>
						<td>{{ficha_alumno.mostrar(examen.estado)}}</td>
						<td>{{ficha_alumno.mostrar(examen.nro_transaccion)}}</td>						
					</tr>
				{% endfor %}					
					</tbody>
				</table>
		{% endfor %}
		
		{% else %}
		<div class="alert alert-block">{{'ficha_alumno.no_hay_informacion'|trans| capitalize}}</div>
		{% endif %}
	</div>
{% endblock %}
