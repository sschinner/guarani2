{% extends "kernel/pagelet.twig" %}
{% import "macro_ficha_alumno.twig" as ficha_alumno %}
{% block contenido %}
	{{ ficha_alumno.render_menu(this.data.menu_reportes, this.data.categoria_actual, this.data.reporte_actual) }}
	<div id="reporte_contenido">
		<h3>{{ 'ficha_alumno.rep_antecedentes_academicos' | trans }}</h3>
		{% for carrera in this.data.carreras %}
		
			{% if carrera.antecedentes %}
				<table class='table table-condensed table-hover table-striped'>
						<thead>
							<tr>
								<th>{{'ficha_alumno.titulo_superior'|trans|capitalize}}</th>
								<th>{{'ficha_alumno.otorgado_por'|trans|capitalize}}</th>
								<th>{{'ficha_alumno.fecha_de_ingreso'|trans|capitalize}}</th>
								<th>{{'ficha_alumno.fecha_de_egreso'|trans|capitalize}}</th>
								<th>{{'ficha_alumno.categoria_coneau'|trans}}</th>
							</tr>
						</thead>
						<tbody>
							{% for antecedente in carrera.antecedentes %}
								<tr>
									<td>{{ficha_alumno.mostrar(antecedente.titulo_superior)}}</td>
									<td>{{ficha_alumno.mostrar(antecedente.otorgado_por)}}</td>
									<td>{{ficha_alumno.mostrar(antecedente.fecha_de_ingreso)}}</td>
									<td>{{ficha_alumno.mostrar(antecedente.fecha_de_egreso)}}</td>
									<td>{{ficha_alumno.mostrar(antecedente.categoria_coneau)}}</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
			{% else %}
				<div class="alert text-warning">{{'ficha_alumno.no_hay_antecedentes'|trans|capitalize}}</div>
			{% endif %}
		
		{% else %}
			<div class="alert text-warning">{{'ficha_alumno.no_hay_informacion'|trans}}</div>
		{% endfor %}
	</div>
{% endblock %}
