{% if tipo == 'detalle_equivalencia'%}
	<p><!--{{"Vencimiento" | trans | capitalize}}: {% if FECHA_VENCIMIENTO %}{{FECHA_VENCIMIENTO}}{%else%}{{'sin_definir' | trans | capitalize}}{% endif %}</br>-->
	{{"Nro. resolución" | trans | capitalize}}: {% if NRO_RESOLUCION %}{{NRO_RESOLUCION}}{%else%}{{'sin_definir' | trans | capitalize}}{% endif %}</br>	
	{{"Temas a rendir" | trans | capitalize}}: {% if TEMAS_A_RENDIR %}{{TEMAS_A_RENDIR}}{%else%}{{'sin_definir' | trans | capitalize}}{% endif %}
	</p>
{% endif %}

