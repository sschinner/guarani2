{% macro render_paginator(pages, current_page, header) %}
    {% if not current_page %}
		{% set current_page = 1 %}
    {% endif %}
    {% if pages %}
	{% if pages|length > 1 %}
	<span class="acchide">P&aacute;ginas</span>
	<ul>
		{% if header %}
			<li class="disabled"><span aria-disabled="true" role="button">{{ header|trans|capitalize }}</span></li>
		{% endif %}
			
	    {% if pages[current_page - 1] %}
			<li class='pager_prev'><a role="button" href='{{ pages[current_page - 1] }}' class='pager_link'>{{ 'anterior'|trans | capitalize }}</a></li>
	    {% endif %}

		
	    {% for key,value in pages %}
			{% if key == current_page %}
				{% if pages|length == current_page %}
					<li class='active'><span role="button" aria-pressed="true">{{key}}</span></li>
				{% else %}
					<li class='active'><a role="button" aria-pressed="true" href='#' class='pager_link'>{{key}}</a></li>
				{% endif %}
			{% else %}
				<li><a role="button" href='{{ value }}' class='pager_link'>{{key}}</a></li>
			{% endif %}
	    {% endfor %}
				
	    {% if pages[current_page + 1] %}
			<li class='pager_next'><a role="button" href='{{ pages[current_page + 1] }}' class='pager_link'>{{ 'siguiente'|trans | capitalize }}</a></li>
	    {% endif %}
	</ul>
    {% endif %}
    {% endif %}
{% endmacro %}

{% macro render_paginator_without_numbers(url_prev, url_next) %}
    <ul>
	{% if url_prev %}
		<li class='pager_prev'><a href='{{ url_prev }}' class='pager_link'>&larr; {{ 'anterior'|trans | capitalize }}</a></li>
	{% else %}
		<li class='pager_prev disabled'><span class='pager_link'>&nbsp;</span></li>
	{% endif %}

	{% if url_next %}
		<li class='pager_next'><a href='{{ url_next }}' class='pager_link'>{{ 'siguiente'|trans | capitalize }} &rarr;</a></li>
	{% else %}
		<li class='pager_next disabled'><span class='pager_link'>&nbsp;</span></li>
	{% endif %}
    </ul>
{% endmacro %}
