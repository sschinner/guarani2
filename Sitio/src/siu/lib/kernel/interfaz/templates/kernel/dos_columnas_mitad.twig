{% if js_vars %}
	<script type='text/javascript'>
	{% for name, value in js_vars %}
		var {{name}} = '{{value}}';
	{% endfor %}
	</script>
{% endif %}

<div class='titulo_operacion row-fluid'>
    <div class="span12">
	{% block titulo_operacion %}{% endblock %}
    </div>
</div>

<div id='' class="row-fluid">
    <div id='columna_1' class="span5" style="width: 45%" >{% block columna_1 %}{% endblock %}</div>
    <div id='columna_2' class="span5" style="width: 45%;margin-left: 80px">{% block columna_2 %}{% endblock %}</div>
</div>
