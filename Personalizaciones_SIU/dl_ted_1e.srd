compute(band=header alignment="0" expression="'La ' + universidad_nombre +  ' certifica que ' + Trim(persona_apellido) + ' ' + Trim(persona_nombres) + ', Legajo Nº ' +  trim(legajo_alumno) + ', ' +  tipo_doc_desc_abrev + ' N° ' + nro_documento + ', quien ingresó con el título de ' + titulo_nivel_anterior + ' de ' + institucion_tit_nivel_anterior + if( inst_tit_nivel_ant_ext ='S' AND NOT IsNull(tit_ant_situacion_conv), ' (' +  tit_ant_situacion_conv + ')','') + ', ha cursado y aprobado las asignaturas correspondientes al plan de estudios de la carrera de ' + carreras_nombre +  ', Resolución Ministerial Nº ' + if(isnull(nro_resolucion_minist_titulo_plan), '', nro_resolucion_minist_titulo_plan)  + ', Resolución CONEAU Nº ' + if(isnull(nro_resolucion_coneau_titulo_plan), '', nro_resolucion_coneau_titulo_plan) + ', obteniendo las siguientes calificaciones que abajo se expresan: ' "border="0" color="0" x="18" y="352" height="340" width="3214" format="[GENERAL]"  name=comp_cabecera visible="1~tif(page() = 1, 1,0)"  slideup=allabove  font.face="Arial" font.height="-9" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215"  height.autosize=yes)
